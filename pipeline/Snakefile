# Run:
#   snakemake -n                              # dry run
#   snakemake --use-conda -c32 tier_counts    # STOP HERE, inspect the counts
#   snakemake --use-conda -c32 mvp            # MVP target (~5-7 days)
#   snakemake --use-conda -c32 all            # full (~3 weeks)
