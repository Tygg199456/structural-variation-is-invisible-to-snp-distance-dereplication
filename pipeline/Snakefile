import os
import subprocess
import sys
from pathlib import Path

configfile: "config.yaml"

# BUG 4 guard: snakemake's `script:` directive prepends a preamble to every
# script, so a `from __future__` import stops being the first statement and
# the script dies at runtime -- after the upstream work is already paid for.
# Fail here instead, in the first second.
subprocess.run([sys.executable, os.path.join(workflow.basedir, "scripts/_lint_scripts.py")],
               check=True)

RES   = config["paths"]["results"]
DATA  = config["paths"]["data"]
LOGS  = config["paths"]["logs"]
REF   = config["ref"]["accession"]

wildcard_constraints:
    tier   = "A|B|C",
    set    = "tierA|tierB",
    acc    = r"GC[AF]_\d+\.\d+",
    sample = r"[A-Za-z0-9._-]+",


# ------------------------------------------------------------------ checkpoints
# Tier membership is not knowable until QC and dedup have run, so sample lists
# are resolved through checkpoints rather than globbed up front.

def tier_samples(tier):
    """Read the accession list a checkpoint produced for one tier."""
    if tier == "A":
        ck = checkpoints.tier_a_dedup.get().output.keep
    elif tier == "B":
        ck = checkpoints.tier_b_backbone.get().output.keep
    else:
        ck = checkpoints.tier_c_select.get().output.keep
    with open(ck) as fh:
        return [ln.split("\t")[0] for ln in fh if ln.strip()
                and not ln.startswith("#")]

def tier_a(_=None):  return tier_samples("A")
def tier_b(_=None):  return tier_samples("B")
def tier_c(_=None):  return tier_samples("C")


def outgroup_accessions():
    """Accessions that must never enter the dating set.

    Outgroups violate the molecular clock assumption; leaving one in the
    BEAST taxa set drags the rate estimate. They are here as root polarisers
    only.
    """
    og = [config["outgroup"]["primary"]] + list(config["outgroup"].get("extra", []))
    return set(og)


# ---------------------------------------------------------------- tier guard
# Hard stop if a rule tries to feed a tier into a forbidden analysis.
def assert_use(tier, use):
    allowed = config["tiers"][tier]["permitted_uses"]
    if use not in allowed:
        raise WorkflowError(
            f"TIER VIOLATION: Tier {tier} may not be used for '{use}'. "
            f"Permitted: {allowed}. See config.yaml 'TIER DEFINITIONS'."
        )
    return True


include: "rules/00_fetch.smk"
include: "rules/01_qc.smk"
include: "rules/02_dedup.smk"
include: "rules/03_ancient.smk"
