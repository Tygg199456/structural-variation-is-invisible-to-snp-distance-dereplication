# ================================================================== TARGETS

rule tier_counts:
    """
    GATE 1a -- metadata only. Minutes, no downloads. Read this before
    committing any compute: it is the decision point, not a progress report.

    Nothing here needs sequence, so the ~4,585 downloads that v1 required
    before you could see a number are gone.
    """
    input:
        f"{RES}/qc/tier_report.tsv",
        f"{RES}/qc/metadata_completeness.tsv",
        f"{RES}/qc/tierA_candidates.tsv",
        f"{RES}/qc/tierB_candidates.tsv",


rule gate1b:
    """
    GATE 1b -- Tier A dnadiff cover gate ONLY. 256 downloads + 256 dnadiff, 1-2 h.

    Deliberately does NOT pull dedup/tierA_keep.tsv or dedup/tierB_backbone.tsv:
    those transitively require a snippy run for every Tier B accession (3,441
    genomes, 10-14 h). A gate whose stated cost is 1-2 h must not silently
    depend on the 10-14 h step.
    """
    input:
        f"{RES}/qc/tierA_refined.tsv",


rule gate1c:
    """
    GATE 1c -- Tier A SNP dedup. Reuses gate1b's 256 downloads, adds 256
    snippy runs and the Tier A genotype matrix.
    """
    input:
        f"{RES}/dedup/tierA_keep.tsv",


rule gate1d:
    """
    GATE 1d -- Tier B: 3,441 downloads + snippy + backbone dedup. 10-14 h.
    snippy output is cached per sample, so gate1c's 256 runs are reused here.
    """
    input:
        f"{RES}/dedup/tierB_backbone.tsv",


rule mvp:
    """
    Minimum publishable unit: Tier A only, no ancient DNA, no BEAST.
    LSD2 supplies relative dating. ~5-7 days on 32 cores.
    """
    input:
        f"{RES}/pangenome/gene_presence_absence.Rtab",
        f"{RES}/pseudogene/pseudo_matrix.tsv",
        f"{RES}/phylogeny/tierA.treefile",
        f"{RES}/dating/lsd2_tierA.nex",
        f"{RES}/asr/pastml_events.tsv",
        f"{RES}/fba/growth_matrix.tsv",
        f"{RES}/figures/fig1_tree.pdf",
        f"{RES}/figures/fig2_pangenome.pdf",
        f"{RES}/figures/fig3_parallel_loss.pdf",
        f"{RES}/figures/fig5_fba.pdf",
        f"{RES}/figures/figS1_checkm_bias.pdf",
        f"{RES}/tables/table1_datasets.tsv",
        f"{RES}/tables/table2_parallel_genes.tsv",


rule all:
    """Full study. Adds Tier B backbone tree, Tier C ancient genomes, BEAST."""
    input:
        rules.mvp.input,
        f"{RES}/phylogeny/backbone.treefile",
        f"{RES}/phylogeny/allB_veryfasttree.nwk",
        f"{RES}/dating/beast_global.mcc.tree",
        f"{RES}/dating/drt_summary.tsv",
        f"{RES}/dating/population_clock_gates.tsv",
        f"{RES}/figures/fig4_circos_is.pdf",
        f"{RES}/figures/fig6_decay_rate.pdf",
        f"{RES}/figures/figS2_downsample_control.pdf",
        f"{RES}/figures/figS3_draft_pav_bias.pdf",
        f"{RES}/figures/figS4_dedup_topology.pdf",


rule clean_scratch:
    shell:
        "rm -rf {RES}/tmp {LOGS}/*.tmp"
